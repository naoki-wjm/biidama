# 送り先（見本）。実物は .env に置く（.gitignore 済み）。設定ファイルと同じ場所に置く
#   biidama publish -c config.local.yml --dry-run   # 何を送るか見るだけ
#   biidama publish -c config.local.yml             # 送る

# ssh の接続先。~/.ssh/config の別名でも、ホスト名でもよい
BIIDAMA_HOST=example
# 遠隔側の置き場（ホームからの相対パスか絶対パス）。この中だけを上書きする
BIIDAMA_REMOTE_DIR=web/site/
# 以下は任意。~/.ssh/config に書いてあれば空でよい
BIIDAMA_USER=
BIIDAMA_PORT=
BIIDAMA_KEY=
